PORT=3001

# Railway
MYSQL_URL=mysql://root:password@mysql.railway.internal:3306/railway
MYSQLHOST=mysql.railway.internal
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=password
MYSQLDATABASE=railway

# Frontend origin allowed by CORS when frontend and backend are deployed separately
CORS_ORIGIN=https://tu-frontend.up.railway.app

# Enable only if your MySQL provider requires SSL
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
